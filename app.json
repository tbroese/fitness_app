{
  "expo": {
    "name": "Inertia",
    "slug": "fitnessapp",
    "scheme": "fitnesstracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tannerbroese.fitnesstracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to verify your presence at the gym and track your workout streak.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We use background location to automatically detect when you visit the gym and keep your streak updated.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.tannerbroese.fitnesstracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#181818",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Inertia uses background location to automatically verify your 15-minute gym visits even when the app is closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "931f71b9-391a-403e-a994-654cc615b2c5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/931f71b9-391a-403e-a994-654cc615b2c5"
    }
  }
}
